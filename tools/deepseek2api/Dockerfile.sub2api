FROM golang:1.26-alpine AS build
WORKDIR /src/deepseek2api
ARG GOPROXY=https://goproxy.cn,direct
ARG GOSUMDB=sum.golang.google.cn
ENV GOPROXY=${GOPROXY} GOSUMDB=${GOSUMDB}
COPY builtinlogin /src/builtinlogin
COPY deepseek2api/go.mod deepseek2api/go.sum ./
RUN go mod download
COPY deepseek2api/*.go ./
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/adapter .

FROM alpine:3.20
RUN apk add --no-cache ca-certificates chromium tzdata wget \
 && adduser -D -u 10001 app \
 && mkdir -p /app/data && chown -R app:app /app
WORKDIR /app
COPY --from=build /out/adapter /app/adapter
USER app
EXPOSE 7867
ENTRYPOINT ["/app/adapter"]
